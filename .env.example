# ---------------------------------------------------------------------------
# Copy to .env.local (gitignored) and fill in for local development.
# On GitHub, set the two emails as repository SECRETS and the names as
# repository VARIABLES so the public repo never contains the addresses.
# ---------------------------------------------------------------------------

VITE_PARTNER_ONE_NAME=
VITE_PARTNER_ONE_EMAIL=
VITE_PARTNER_TWO_NAME=
VITE_PARTNER_TWO_EMAIL=

# Which Bible provider to use: "preview" (default) or "api-bible".
# "api-bible" requires NLT access to be approved for your API.Bible key.
VITE_BIBLE_PROVIDER=

# API.Bible (https://api.bible) credentials.
# A VITE_* value is bundled into the browser: acceptable for a private POC only.
# For production deploy a proxy, set VITE_BIBLE_PROVIDER_BASE_URL to it, and
# leave VITE_API_BIBLE_KEY empty.
VITE_API_BIBLE_KEY=
VITE_API_BIBLE_BASE_URL=
# Optional: pin the NLT bible id from your API.Bible dashboard.
VITE_API_BIBLE_ID=

# Optional proxy implementing the adapter contract in
# src/services/bibleProvider.ts (LicensedNltProvider). Takes precedence.
VITE_BIBLE_PROVIDER_BASE_URL=

VITE_PREVIEW_MODE=true
