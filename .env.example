# ---------------------------------------------------------------------------
# Copy to .env.local (gitignored) for local development.
#
# NEVER put an email address or a secret in a VITE_* value: Vite inlines every
# one of them into the public JavaScript bundle, so whatever you put here is
# visible to anyone who opens the deployed site. Partner addresses live only in
# the ALLOWED_EMAILS Supabase secret and in the database.
#
# The real deployment values are in .env.production (committed, public by design).
# ---------------------------------------------------------------------------

# Display names only.
VITE_PARTNER_ONE_NAME=Sam
VITE_PARTNER_TWO_NAME=Sammy

# ---------------------------------------------------------------------------
# Data + auth backend.
# local    -> browser-only demo store (no accounts server, no email, no real NLT)
# supabase -> Supabase Auth + Postgres with row level security
# ---------------------------------------------------------------------------
VITE_DATA_MODE=local
VITE_SUPABASE_URL=
# The publishable ("anon") key is public by design; RLS protects the data.
VITE_SUPABASE_ANON_KEY=

# Which Bible provider to use: "preview" (default) or "api-bible".
# "api-bible" requires NLT access to be approved for your API.Bible key.
VITE_BIBLE_PROVIDER=

# Preferred for production: point this at the `bible` edge function that proxies
# API.Bible, so the API key never reaches the browser.
#   https://<project-ref>.supabase.co/functions/v1/bible
VITE_BIBLE_PROVIDER_BASE_URL=

# API.Bible (https://api.bible) credentials.
# A VITE_* value is bundled into the browser: acceptable for a private POC only.
# For production deploy the proxy above and leave these empty.
VITE_API_BIBLE_KEY=
VITE_API_BIBLE_BASE_URL=
# Optional: pin the NLT bible id from your API.Bible dashboard.
VITE_API_BIBLE_ID=
