# Production build configuration for the Cloudflare Workers deployment.
#
# Every value here is PUBLIC by design: Vite inlines VITE_* into the JavaScript
# bundle. That is safe for the Supabase URL and publishable key (row level
# security protects the data) and for the Bible proxy URL (the API.Bible key
# stays server-side). Never put a real secret or a personal email address here —
# see src/lib/identities.ts for why.
#
# Partner email addresses are intentionally absent: the invite list lives in the
# `ALLOWED_EMAILS` Supabase secret and is enforced by the create-account function.

VITE_DATA_MODE=supabase

VITE_SUPABASE_URL=https://iihmeoccxvjfvnwcuanq.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_GqwmY7DpDEGkST4Rr0NBaQ_RFVeiwsl

# Licensed NLT comes from the `bible` edge function, which proxies API.Bible so
# the API key never reaches the browser.
VITE_BIBLE_PROVIDER_BASE_URL=https://iihmeoccxvjfvnwcuanq.supabase.co/functions/v1/bible

# Display names only — no addresses.
VITE_PARTNER_ONE_NAME=Sam
VITE_PARTNER_TWO_NAME=Sammy
